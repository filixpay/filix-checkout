# Copy to .env.local and fill in your FilixPay credentials.
# Never commit .env.local — it is listed in .gitignore.
# All URLs below are required — there are no production defaults in code.

# --- FilixPay backend API (server-side only) ---
FILIXPAY_BACKEND_CLIENT_ID=your-backend-client-id
FILIXPAY_BACKEND_CLIENT_SECRET=your-backend-client-secret
FILIXPAY_TOKEN_URL=https://your-auth-host/realms/your-realm/protocol/openid-connect/token
BACKEND_API_URL=https://your-api-host
FILIXPAY_API_BASE_URL=https://your-api-host
FILIXPAY_ORDER_URL=https://your-api-host/openapi/v1/orders
FILIXPAY_PAY_URL=https://your-api-host/api/v1/checkout/pay
FILIXPAY_CREATE_PAYMENT_SESSION_URL=/api/v1/checkout/create-payment-session
FILIXPAY_UPLOAD_RECEIPT_URL=/api/v1/checkout/upload-receipt
FILIXPAY_RESUME_PEEK_URL=/api/v1/checkout/resume
FILIXPAY_RESUME_CONTINUE_URL=/api/v1/checkout/resume

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL_INTERNAL=http://localhost:3001

# --- OIDC provider (wallet / credit login) ---
KEYCLOAK_CLIENT_ID=your-oidc-client-id
KEYCLOAK_CLIENT_SECRET=your-oidc-client-secret
KEYCLOAK_ISSUER=https://your-auth-host/realms/your-realm

# --- Optional: deployment overrides ---
# PORT=3001
# HOSTNAME=0.0.0.0
